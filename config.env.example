# AI 阅读执行系统 · 运行配置示例
# 复制本文件为 config.env 并填值；所有脚本优先读环境变量，不写死路径。
# 详见 README.md「生成年度进度台账」一节。

# —— 必填（用户运行目录）——
READING_ROOT=            # 工作台根目录：放 index.html + data/（即 reading-system/）

# —— 可选 ——
READING_VAULT=           # Obsidian vault 路径；sync-vault.py / kb-build.py 双轨沉淀目标
VAULT_NOTE_DIR=          # 笔记沉淀目录（统计每本「已沉淀」标记；留空则该列全为 —）
LEDGER_OUT=              # 台账输出路径（默认：工作台根目录下）
LEDGER_WORKBENCH=        # 在线工作台链接（写进台账头部；留空则不写这行）
TARGET=50                # 年度目标本数

# —— 维护者专用（勿提交真实值）——
GH_TOKEN=                # 推送技能包到 GitHub（push-gh.py 经 API 推送，非 git push）
